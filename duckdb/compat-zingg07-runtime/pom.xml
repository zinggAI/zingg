<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.zingg.duckdb</groupId>
    <artifactId>zingg-duckdb</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>compat-zingg07-runtime</artifactId>
  <dependencies>
    <dependency>
      <groupId>io.zingg.duckdb</groupId>
      <artifactId>engine-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.zingg.duckdb</groupId>
      <artifactId>engine-duckdb</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.zingg.duckdb</groupId>
      <artifactId>model-format</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <profiles>
    <profile>
      <id>zingg07-contract</id>
      <activation>
        <property>
          <name>zingg07.contract.profile</name>
          <value>true</value>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>zingg</groupId>
          <artifactId>zingg-common-client-capsule</artifactId>
          <version>0.7.0</version>
          <scope>system</scope>
          <systemPath>${zingg07.contract.jar}</systemPath>
        </dependency>
        <dependency>
          <groupId>org.scala-lang</groupId>
          <artifactId>scala-library</artifactId>
          <version>2.12.10</version>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.0</version>
            <executions>
              <execution>
                <id>add-zingg07-adapter-source</id>
                <phase>generate-sources</phase>
                <goals><goal>add-source</goal></goals>
                <configuration>
                  <sources><source>src/zingg07-contract/java</source></sources>
                </configuration>
              </execution>
              <execution>
                <id>add-zingg07-contract-test-source</id>
                <phase>generate-test-sources</phase>
                <goals><goal>add-test-source</goal></goals>
                <configuration>
                  <sources><source>src/zingg07-contract-test/java</source></sources>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
    </plugins>
  </build>
</project>
